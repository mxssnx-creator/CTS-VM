{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "framework": "nextjs",
  "regions": ["iad1", "sfo1", "cdg1"],
  "functions": {
    "app/api/**/*.ts": {
      "memory": 2048,
      "maxDuration": 30
    }
  },
  "preview": {
    "enabled": true,
    "source": "all"
  }
}
